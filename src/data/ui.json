  "methodsIntro": {
    "en": "How this project handles evidence",
    "zh": "这个项目怎样对待证据"
  },
  "method1Title": {
    "en": "Separate an observation from a strategy",
    "zh": "观察结果与策略分别记录"
  },
  "method1": {
    "en": "A historical rule, factor association, accounting replay and executable portfolio answer different questions. We preserve their separate identities.",
    "zh": "历史规则、因子关联、账户重放与可执行组合回答不同问题，分别保留身份。"
  },
  "method2Title": {
    "en": "Keep the clock visible",
    "zh": "明确每项数据的时点"
  },
  "method2": {
    "en": "Signal formation, execution, valuation, data cutoff and review date are distinct. Historical snapshots do not by themselves establish point-in-time availability.",
    "zh": "信号形成、执行、估值、数据截止与复核日期分别记录。历史快照本身不能证明当时可得。"
  },
  "method3Title": {
    "en": "Preserve failures and corrections",
    "zh": "保留失败与修正"
  },
  "method3": {
    "en": "Old fixed editions and MC-Cxx claims keep their source identity. A newer interpretation does not silently rewrite an old experiment.",
    "zh": "旧固定版本和 MC-Cxx 结论保留来源身份。新的解释不会静默改写旧实验。"
  },
  "method4Title": {
    "en": "Publish reviewed aggregates",
    "zh": "只发布经审核的汇总"
  },
  "method4": {
    "en": "Research computation stays with its data and execution owners. This static site contains no credentials, raw vendor records or private strategy signals. The BMLL pilot remains an exploratory input, not public security-level data.",
    "zh": "研究计算留在数据和执行能力所属项目中。本站不包含凭据、供应商原始记录或私有策略信号。BMLL 试验仍是探索输入，不公开其证券级数据。"
  },
