---
import '../styles/global.css';
import Text from '../components/Text.astro';
const {title='A Study in Small Caps',active='home',description='A continuing cross-market investigation into small-cap returns, risks, liquidity and implementation.'}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
const navigation=[['home',''],['investigations','investigations/'],['evidence','evidence/'],['literature','literature/'],['history','history/'],['methods','methods/']];
---
<!doctype html><html lang="en" data-lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f5f2ea"/><title>{title==='A Study in Small Caps'?title:`${title} · A Study in Small Caps`}</title><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><script is:inline>try{const l=localStorage.getItem('smallcaps-locale');if(l==='zh'){document.documentElement.dataset.lang='zh';document.documentElement.lang='zh-CN';}}catch{}</script></head>
<body data-base={base}><a class="skip" href="#main"><span class="lang-en">Skip to content</span><span class="lang-zh">跳到正文</span></a>
<header class="site-header"><div class="masthead"><a class="brand" href={base}><span class="monogram" aria-hidden="true">s.</span><span>A Study in Small Caps<small><Text k="subtitle"/></small></span></a><button id="locale-toggle" type="button" aria-label="Switch language / 切换语言">中文 / English</button></div><nav aria-label="Primary navigation" data-aria="primaryNavigation">{navigation.map(([key,path])=><a href={`${base}${path}`} aria-current={active===key?'page':undefined}><Text k={key}/></a>)}</nav></header>
<main id="main"><slot/></main>
<footer><div><strong>A Study in Small Caps</strong><p><Text k="footer"/></p><p class="muted"><Text k="footerNote"/></p></div><div class="footer-links"><a href="https://github.com/runchengxie/a-study-in-small-caps"><Text k="repository"/> ↗</a><a href="https://runchengxie.github.io/quant-market-research/downloads/archive/microcap-research.v1.0.10.zh-CN.md"><Text k="archive"/> ↗</a><a href={`${base}methods/`}><Text k="methods"/></a></div></footer>
<script>import {locale,setLocale} from '../lib/i18n.mjs';setLocale(locale());document.querySelector('#locale-toggle')?.addEventListener('click',()=>setLocale(locale()==='en'?'zh':'en'));</script>
</body></html>
