---
import '../styles/global.css';
import Text from '../components/Text.astro';
import Option from '../components/Option.astro';
import ui from '../data/ui.json';
interface Props { title?: string; active?: string; description?: string; cover?: boolean; }
const {title='',active='home',cover=false,description='A continuing cross-market investigation into small-cap returns, risks, liquidity and implementation.'}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
const navigation=[['home',''],['investigations','investigations/'],['evidence','evidence/'],['atlas','atlas/'],['literature','literature/'],['history','history/'],['methods','methods/']];
---
<!doctype html><html lang="en" data-lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f5f2ea"/><title data-page-title={title}>{title ? `${title} · ${ui.brand.en}` : ui.brand.en}</title><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><script is:inline>try{const l=localStorage.getItem('smallcaps-locale');if(l==='zh'){document.documentElement.dataset.lang='zh';document.documentElement.lang='zh-CN';}}catch{}</script><script is:inline>try{const t=localStorage.getItem('smallcaps-theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}</script></head>
<body data-base={base} class:list={[{'cover-page':cover}]}><a class="skip" href="#main"><span class="lang-en">Skip to content</span><span class="lang-zh">跳到正文</span></a>
<header class="site-header"><div class="masthead"><a class="brand" href={base}><span class="monogram" aria-hidden="true">s.</span><span><Text k="brand"/><small><Text k="subtitle"/></small></span></a><div class="header-controls"><label class="theme-control"><span class="sr-only"><Text k="themeLabel"/></span><select id="theme-select" data-aria="themeLabel"><Option value="system" k="themeSystem"/><Option value="light" k="themeLight"/><Option value="dark" k="themeDark"/></select></label><button id="locale-toggle" type="button" aria-label="Switch language / 切换语言">中文 / English</button></div></div><nav aria-label="Primary navigation" data-aria="primaryNavigation">{navigation.map(([key,path])=><a href={`${base}${path}`} aria-current={active===key?'page':undefined}><Text k={key}/></a>)}</nav></header>
<main id="main"><slot/></main>
<footer><div><strong><Text k="brand"/></strong><p><Text k="footer"/></p><p class="muted"><Text k="footerNote"/></p></div><div class="footer-links"><a href="https://github.com/runchengxie/a-study-in-small-caps"><Text k="repository"/> ↗</a><a href="https://runchengxie.github.io/quant-market-research/downloads/archive/microcap-research.v1.0.10.zh-CN.md"><Text k="archive"/> ↗</a><a href={`${base}methods/`}><Text k="methods"/></a></div></footer>
<script>import {initializeTheme} from '../lib/theme.ts';initializeTheme();import {locale,setLocale} from '../lib/i18n.ts';setLocale(locale());document.querySelector('#locale-toggle')?.addEventListener('click',()=>setLocale(locale()==='en'?'zh':'en'));</script>
</body></html>
