---
import Text from './Text.astro';import Option from './Option.astro';import SourceInfo from './SourceInfo.astro';import evidence from '../data/evidence.json';
---
<section class="evidence-section" id="microcap"><div class="section-heading"><p class="eyebrow">01 / <Text k="riskEyebrow"/></p><h2><Text k="microcapTitle"/></h2></div><div class="boundary-note"><p><Text value={evidence.microcap.summaryCaveat??evidence.microcap.caveat}/></p><p>{evidence.microcap.summaryPeriod.start} — {evidence.microcap.summaryPeriod.end}</p></div><div class="filter-row"><label><Text k="count"/><select id="stock-count">{evidence.microcap.summary.map(row=><option value={row.count} selected={row.count===400}>{row.count}</option>)}</select></label></div><div class="metric-grid"><article><span><Text k="drawdown"/></span><strong id="drawdown-value"></strong></article><article><span><Text k="underwater"/></span><strong id="underwater-value"></strong></article></div><div id="risk-chart" class="chart"></div><SourceInfo ids={[evidence.microcap.summarySourceId??evidence.microcap.sourceId]}/>
<div class="nav-panel"><h3><Text k="nav"/></h3><p class="boundary-note"><Text value={evidence.microcap.caveat}/></p><div class="filter-row"><label><Text k="granularity"/><select id="nav-frequency"><Option value="monthly" k="monthly"/><Option value="annual" k="annual"/><Option value="daily" k="daily"/></select></label></div><div id="nav-chart" class="chart"></div><p id="nav-readout" class="chart-readout" aria-live="polite"></p><p class="small muted"><Text k="navNote"/></p><details class="exact-table"><summary><Text k="exactData"/></summary><div class="table-scroll"><table><thead><tr><th><Text k="date"/></th><th>NAV</th></tr></thead><tbody id="nav-data"></tbody></table></div></details><SourceInfo ids={[evidence.microcap.sourceId]}/></div></section>
<section class="evidence-section" id="liquidity"><div class="section-heading"><p class="eyebrow">02 / <Text k="liquidityEyebrow"/></p><h2><Text k="liquidityTitle"/></h2></div><p class="boundary-note"><Text value={evidence.liquidity.caveat}/></p><div class="filter-row"><label><Text k="period"/><select id="liquidity-period">{evidence.liquidity.periods.map(period=><Option value={period.id} text={period.label}/>)}</select></label><label><Text k="basis"/><select id="liquidity-basis"><Option value="absolute" k="absolute"/><Option value="relative" k="relative"/></select></label><label><Text k="bucket"/><select id="liquidity-bucket"></select></label><label><Text k="market"/><select id="liquidity-market"><Option value="all" k="all"/>{['A-share','US','HK','JP'].map(m=><Option value={m} k={m}/>)}</select></label></div><p id="liquidity-scope" class="muted"></p><h3 class="chart-caption"><Text k="liquidityMetric"/></h3><div id="liquidity-chart" class="chart"></div><div id="liquidity-data" class="liquidity-table"></div><p class="small muted"><Text k="chartBoundary"/></p><div id="liquidity-source-absolute"><SourceInfo ids={[evidence.liquidity.sourceId]}/></div><div id="liquidity-source-relative" hidden><SourceInfo ids={[evidence.liquidity.relativeSourceId]}/></div></section>
<script>
import evidence from '../data/evidence.json';import {selectMicrocap,selectLiquidity} from '../lib/research.ts';import {text,format} from '../lib/i18n.ts';
const field=(id:string)=>document.getElementById(id) as HTMLSelectElement;
const escape=(value:unknown)=>String(value).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('"','&quot;');
const svg=(body:string,label:string)=>`<svg viewBox="0 0 860 300" role="img" aria-label="${escape(label)}" xmlns="http://www.w3.org/2000/svg">${body}</svg>`;
const risk=()=>{
 const count=Number(field('stock-count').value);const selected=selectMicrocap(evidence,{count,granularity:field('nav-frequency').value});
 document.getElementById('drawdown-value')!.textContent=selected.summary?format(selected.summary.maxDrawdown,{style:'percent',maximumFractionDigits:1}):'—';
 document.getElementById('underwater-value')!.textContent=selected.summary?`${format(selected.summary.longestUnderwater)} ${text('sessions')}`:'—';
 const source=evidence.microcap.summary;
 document.getElementById('risk-chart')!.innerHTML=svg(source.map((r,i)=>{const y=26+i*50;const width=Math.abs(r.maxDrawdown)*660;return `<text x="18" y="${y+20}" class="svg-label">N=${r.count}</text><rect x="105" y="${y}" width="${width}" height="31" rx="3" fill="${r.count===count?'var(--plot-negative)':'var(--plot-neutral)'}"/><text x="${120+width}" y="${y+21}" class="svg-value">${escape(format(r.maxDrawdown,{style:'percent',maximumFractionDigits:1}))}</text>`;}).join(''),text('drawdown'));
 const chart=document.getElementById('nav-chart')!;const tbody=document.getElementById('nav-data')!;tbody.replaceChildren();
 if(!selected.rows.length){chart.innerHTML=`<p class="empty-state">${escape(text('noNav'))}</p>`;document.getElementById('nav-readout')!.textContent='';return;}
 const rows=selected.rows;const values=rows.map(r=>r.nav);const low=Math.min(...values);const high=Math.max(...values);const range=high-low||1;const x=(i:number)=>70+i/Math.max(1,rows.length-1)*730;const y=(n:number)=>245-(n-low)/range*205;
 const line=rows.map((r,i)=>`${i?'L':'M'}${x(i).toFixed(2)},${y(r.nav).toFixed(2)}`).join(' ');
 chart.innerHTML=svg(`<line x1="70" y1="245" x2="800" y2="245" stroke="var(--line)"/><text x="18" y="44" class="svg-label">${escape(format(high,{maximumFractionDigits:1}))}</text><text x="18" y="247" class="svg-label">${escape(format(low,{maximumFractionDigits:1}))}</text><path d="${line}" fill="none" stroke="var(--plot-positive)" stroke-width="2.5"/><text x="70" y="278" class="svg-label">${rows[0].date}</text><text x="800" y="278" text-anchor="end" class="svg-label">${rows.at(-1)!.date}</text>`,text('nav'));
 let index=rows.length-1;const update=()=>{const row=rows[index];document.getElementById('nav-readout')!.textContent=`${row.date} · NAV ${format(row.nav,{maximumFractionDigits:4})}`;};const surface=chart.querySelector('svg')!;surface.setAttribute('tabindex','0');surface.addEventListener('keydown',(event)=>{const e=event as KeyboardEvent;if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();index=Math.max(0,Math.min(rows.length-1,index+(e.key==='ArrowLeft'?-1:1)));update();}});surface.addEventListener('pointermove',event=>{const box=surface.getBoundingClientRect();index=Math.max(0,Math.min(rows.length-1,Math.round((((event as PointerEvent).clientX-box.left)/box.width*860-70)/730*(rows.length-1))));update();});update();
 for(const r of rows){const tr=document.createElement('tr');for(const value of [r.date,format(r.nav,{maximumFractionDigits:6})]){const td=document.createElement('td');td.textContent=value;tr.append(td);}tbody.append(tr);}
};
const buckets=()=>{const select=field('liquidity-bucket');const old=select.value;select.replaceChildren();const values=evidence.liquidity.buckets[field('liquidity-basis').value as 'absolute'|'relative'];values.forEach((v,i)=>{const option=document.createElement('option');option.value=String(i);option.textContent=v;select.append(option);});select.value=Number(old)<values.length&&old!==''?old:'1';};
const liquidity=()=>{
 const selected=selectLiquidity(evidence,{period:field('liquidity-period').value,basis:field('liquidity-basis').value as 'absolute'|'relative',bucket:Number(field('liquidity-bucket').value),market:field('liquidity-market').value});
 document.getElementById('liquidity-scope')!.textContent=selected.period?`${selected.period.start} — ${selected.period.end} · ${selected.period.markets.map(m=>text(m)).join(' / ')}`:'';
 const allMarkets=[...new Set(evidence.liquidity.periods.flatMap(p=>p.markets))];const displayMarkets=field('liquidity-market').value==='all'?allMarkets:[field('liquidity-market').value];const rows=selected.rows.filter(r=>r.medianUSD!==null);document.getElementById('liquidity-source-absolute')!.hidden=field('liquidity-basis').value==='relative';document.getElementById('liquidity-source-relative')!.hidden=field('liquidity-basis').value!=='relative';const chart=document.getElementById('liquidity-chart')!;const table=document.getElementById('liquidity-data')!;table.replaceChildren();
 if(!rows.length){chart.innerHTML=`<p class="empty-state">${escape(text(selected.period?.markets.includes(field('liquidity-market').value)?'emptyBucket':'marketNotIncluded'))}</p>`;}
 const max=Math.max(...rows.map(r=>r.medianUSD??0))||1;
 if(rows.length)chart.innerHTML=svg(rows.map((r,i)=>{const y=26+i*62;const w=(r.medianUSD??0)/max*535;return `<text x="12" y="${y+23}" class="svg-label">${escape(text(r.market))}</text><rect x="220" y="${y}" width="${w}" height="34" rx="3" fill="var(--plot-positive)"/><text x="${230+w}" y="${y+23}" class="svg-value">$${escape(format(r.medianUSD??0,{notation:'compact',maximumFractionDigits:1}))}</text>`;}).join(''),text('liquidityMetric'));
 for(const market of displayMarkets){const r=selected.rows.find(row=>row.market===market);const row=document.createElement('div');row.className='liquidity-value';const present=selected.period?.markets.includes(market);const values=!present?[text(market),'—',text('marketNotIncluded'),'']:!r?[text(market),'—',text('missingGroupValue'),'']:[text(market),r.medianUSD===null?'—':'$'+format(r.medianUSD,{maximumFractionDigits:2}),r.medianUSD===null?text('emptyBucketShort'):`${format(r.observations)} ${text('observations')}`,`${format(r.stocks)} ${text('stocks')}`];for(const value of values){const span=document.createElement('span');span.textContent=value;row.append(span);}table.append(row);}
};
field('stock-count').addEventListener('change',risk);field('nav-frequency').addEventListener('change',risk);field('liquidity-basis').addEventListener('change',()=>{buckets();liquidity();});for(const id of ['liquidity-period','liquidity-bucket','liquidity-market'])field(id).addEventListener('change',liquidity);document.addEventListener('research:locale',()=>{risk();liquidity();});buckets();risk();liquidity();
</script>
