---
import Text from './Text.astro';
import ChartLegend from './ChartLegend.astro';
import SourceInfo from './SourceInfo.astro';
import ui from '../data/diagnostic-ui.json';
import data from '../../public/evidence/nav-diagnostics.json';
---
<section class="evidence-section" id="nav-diagnostics"><h2><Text value={ui.title}/></h2><p class="boundary-note"><Text value={ui.scope}/></p><label><Text value={ui.metric}/><select id="diagnostic-metric">{(['minimum','maximum','negativeFraction'] as const).map(key=><option value={key} data-en={ui[key].en} data-zh={ui[key].zh}>{ui[key].en}</option>)}</select></label><ChartLegend/><div id="diagnostic-chart" class="chart"></div><div class="table-scroll"><table><thead><tr>{['sessions','observations','worstStart','worstEnd','value'].map(key=><th><Text value={ui[key as keyof typeof ui]}/></th>)}</tr></thead><tbody id="diagnostic-data">{data.rolling.map(row=><tr><td>{row.sessions}</td><td>{row.observations}</td><td>{row.worstStart}</td><td>{row.worstEnd}</td><td>{(row.minimum*100).toFixed(2)}%</td></tr>)}</tbody></table></div><SourceInfo ids={['SRC-NAV-DIAG']}/></section>
<script>
import data from '../../public/evidence/nav-diagnostics.json';
import ui from '../data/diagnostic-ui.json';
import {local,format} from '../lib/i18n.ts';
type Metric='minimum'|'maximum'|'negativeFraction';
const field=document.querySelector<HTMLSelectElement>('#diagnostic-metric')!;
const render=()=>{
 const metric=field.value as Metric;
 const values=data.rolling.map(row=>row[metric]);const low=Math.min(0,...values);const high=Math.max(0,...values);const span=high-low||1;const x=(v:number)=>120+(v-low)/span*480;
 const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('viewBox','0 0 760 260');svg.setAttribute('role','img');svg.setAttribute('aria-label',local(ui[metric]));
 const label=(content:string,px:number,py:number)=>{const t=document.createElementNS(svg.namespaceURI,'text');t.setAttribute('x',String(px));t.setAttribute('y',String(py));t.setAttribute('fill','currentColor');t.setAttribute('font-size','14');t.textContent=content;svg.append(t);};
 data.rolling.forEach((row,i)=>{const value=row[metric],y=20+i*58;const rect=document.createElementNS(svg.namespaceURI,'rect');rect.setAttribute('x',String(Math.min(x(0),x(value))));rect.setAttribute('y',String(y));rect.setAttribute('width',String(Math.max(1,Math.abs(x(value)-x(0)))));rect.setAttribute('height','28');rect.setAttribute('fill',metric==='negativeFraction'?'var(--plot-series)':value<0?'var(--plot-negative)':value>0?'var(--plot-positive)':'var(--plot-neutral)');svg.append(rect);label(String(row.sessions),12,y+20);label(format(value,{style:'percent',maximumFractionDigits:2,signDisplay:metric==='negativeFraction'?'auto':'exceptZero'}),620,y+20);});
 document.querySelector('#diagnostic-chart')!.replaceChildren(svg);
 document.querySelectorAll<HTMLTableRowElement>('#diagnostic-data tr').forEach((row,i)=>{const observation=data.rolling[i];row.cells[2].textContent=metric==='minimum'?observation.worstStart:metric==='maximum'?observation.bestStart:'—';row.cells[3].textContent=metric==='minimum'?observation.worstEnd:metric==='maximum'?observation.bestEnd:'—';row.cells[4].textContent=format(observation[metric],{style:'percent',maximumFractionDigits:2,signDisplay:metric==='negativeFraction'?'auto':'exceptZero'});});
};field.addEventListener('change',render);document.addEventListener('research:locale',render);render();
</script>
