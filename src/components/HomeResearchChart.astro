---
import Text from './Text.astro';
import ui from '../data/home-chart-ui.json';
import evidence from '../data/evidence.json';
const years=[...new Set(evidence.microcap.series[0].rows.map(row=>row.date.slice(0,4)))];
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<section class="section home-research-chart"><div class="section-heading"><h2><Text value={ui.title}/></h2></div><p><Text value={ui.intro}/></p><label><Text value={ui.year}/><select id="home-chart-year"><option value="all" data-en={ui.all.en} data-zh={ui.all.zh}>{ui.all.en}</option>{years.map(year=><option value={year}>{year}</option>)}</select></label><div id="home-drawdown-chart"></div><p id="home-chart-readout" aria-live="polite"></p><p class="small muted"><Text value={ui.scope}/></p><a class="text-link" href={`${base}evidence/#research-lab`}><Text value={ui.open}/> ↗</a><a class="record-ref" href={`${base}methods/#SRC-NAV`}>SRC-NAV</a></section>
<script>
import evidence from '../data/evidence.json';import ui from '../data/home-chart-ui.json';import {local,format} from '../lib/i18n.ts';
let peak=0;const rows=evidence.microcap.series[0].rows.map(row=>{peak=Math.max(peak,row.nav);return {...row,drawdown:row.nav/peak-1};});
const field=document.querySelector<HTMLSelectElement>('#home-chart-year')!;
const render=()=>{const selected=rows.filter(row=>field.value==='all'||row.date.startsWith(field.value));const floor=Math.min(...rows.map(row=>row.drawdown));const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('viewBox','0 0 1000 260');svg.setAttribute('role','img');svg.setAttribute('aria-label',local(ui.drawdown));const first=Date.parse(selected[0].date),last=Date.parse(selected.at(-1)!.date);const x=(date:string)=>60+(Date.parse(date)-first)/(last-first||1)*920;const y=(value:number)=>30+value/floor*180;
const path=document.createElementNS(svg.namespaceURI,'path');path.setAttribute('d',`M60 30 ${selected.map(row=>`L${x(row.date)} ${y(row.drawdown)}`).join(' ')} L980 30 Z`);path.setAttribute('fill','var(--plot-negative)');path.setAttribute('opacity','.7');svg.append(path);
const label=(value:string,px:number,py:number)=>{const text=document.createElementNS(svg.namespaceURI,'text');text.setAttribute('x',String(px));text.setAttribute('y',String(py));text.setAttribute('fill','currentColor');text.setAttribute('font-size','14');text.textContent=value;svg.append(text);};label('0%',8,34);label(format(floor,{style:'percent',maximumFractionDigits:0}),8,212);label(selected[0].date,60,245);label(selected.at(-1)!.date,880,245);
const readout=document.querySelector('#home-chart-readout')!;const show=(i:number)=>{const row=selected[Math.max(0,Math.min(selected.length-1,i))];readout.textContent=`${row.date} · ${local(ui.drawdown)} ${format(row.drawdown,{style:'percent',maximumFractionDigits:2})}`;};let index=selected.length-1;svg.setAttribute('tabindex','0');svg.addEventListener('pointermove',event=>{const rect=svg.getBoundingClientRect();const date=first+Math.max(0,Math.min(1,((event.clientX-rect.left)/rect.width*1000-60)/920))*(last-first);index=selected.reduce((best,row,i)=>Math.abs(Date.parse(row.date)-date)<Math.abs(Date.parse(selected[best].date)-date)?i:best,0);show(index);});svg.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'||event.key==='ArrowRight'){event.preventDefault();index=Math.max(0,Math.min(selected.length-1,index+(event.key==='ArrowRight'?1:-1)));show(index);}});document.querySelector('#home-drawdown-chart')!.replaceChildren(svg);show(index);};field.addEventListener('change',render);document.addEventListener('research:locale',render);render();
</script>
<style>.home-research-chart{border-top:1px solid var(--line)}#home-drawdown-chart{margin-top:1.5rem}#home-drawdown-chart :global(svg){width:100%;display:block}#home-chart-readout{min-height:1.6em;font-variant-numeric:tabular-nums}.record-ref{margin-left:1rem}</style>
