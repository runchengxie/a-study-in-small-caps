---
import Text from './Text.astro';
import ChartLegend from './ChartLegend.astro';
import Option from './Option.astro';
import atlas from '../data/atlas.json';
---
<section class="evidence-section" id="migrated-charts"><h2><Text k="atlasPanels"/></h2><div class="filter-row"><label><Text k="atlasPanels"/><select id="atlas-panel">{atlas.panels.map(panel=><Option value={panel.id} text={panel.title}/>)}</select></label><label><Text k="atlasMetric"/><select id="atlas-metric"></select></label></div><h3 id="atlas-title"></h3><p class="boundary-note" id="atlas-limit"></p><p class="small muted"><Text k="atlasUnits"/>: <span id="atlas-units"></span></p><div class="filter-row" id="atlas-filters"></div><button id="atlas-reset" type="button"><Text k="atlasReset"/></button><p id="atlas-count" aria-live="polite"></p><ChartLegend/><div id="atlas-chart" class="chart"></div><p id="atlas-chart-note" class="small muted"></p><p id="atlas-source"></p><details class="exact-table"><summary><Text k="exactData"/></summary><div class="table-scroll"><table><thead id="atlas-head"></thead><tbody id="atlas-body"></tbody></table></div></details><noscript><p><Text k="searchNoScript"/></p></noscript></section>
<section class="evidence-section" id="source-inventory"><h2><Text k="atlasSources"/></h2><p class="boundary-note"><Text k="atlasRegisterNote"/></p><label><Text k="atlasSearch"/><input type="search" id="atlas-search" data-atlas-placeholder="atlasSearchPlaceholder"/></label><p id="atlas-source-count" aria-live="polite"></p><div class="atlas-records">{atlas.items.map(item=><article class="atlas-record" data-atlas-search={JSON.stringify(item).toLowerCase()} id={`source-${item.id}`}><p class="eyebrow"><Text value={item.family}/></p><h3><Text value={item.title}/></h3><p><strong><Text value={item.stage}/></strong></p>{'conclusion' in item&&<p><Text value={item.conclusion}/></p>}<p class="small muted"><Text value={item.limits}/></p><p><a href={item.url}><Text k="atlasSource"/></a></p><details><summary><Text k="sourceDetails"/></summary><dl><dt><Text k="atlasOriginalSource"/></dt><dd><code>{item.sourcePath}</code></dd><dt><Text k="atlasRevision"/></dt><dd><code>{item.revision}</code></dd><dt><Text k="atlasFingerprint"/></dt><dd><code>{item.sha256}</code></dd>{item.reviewedOn&&<><dt><Text k="reviewedOn"/></dt><dd>{item.reviewedOn}</dd></>}</dl></details></article>)}</div></section>
<script>
import {initializeAtlas} from '../lib/atlas.ts';
initializeAtlas();
</script>
<style>
.atlas-records{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:1rem;margin-top:2rem}.atlas-record{border:1px solid var(--line,#ccc);padding:1.2rem;min-width:0}.atlas-record[hidden]{display:none}.atlas-record code{overflow-wrap:anywhere;white-space:normal;font-size:.75rem}.atlas-record dd{margin-inline-start:0}.atlas-record h3{font-size:1.2rem}#atlas-search{display:block;width:100%;padding:.8rem;margin-top:.5rem}#atlas-chart{overflow:auto}#atlas-chart svg{min-width:680px}button{cursor:pointer;padding:.5rem 1rem}
</style>
