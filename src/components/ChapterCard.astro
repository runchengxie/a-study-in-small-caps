---
import Text from './Text.astro';
const {chapter,listing=false}=Astro.props;const Heading=listing?'h2':'h3';const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<article class:list={["chapter-card",{"chapter-list-item":listing}]}><div class="eyebrow"><span>{chapter.id}</span><span class="status"><Text k={chapter.stage==='methods'?'methodsStage':chapter.stage}/></span></div><Heading><a href={`${base}investigations/${chapter.slug}/`}><Text value={chapter.title}/></a></Heading><p><Text value={listing?chapter.conclusion:chapter.summary}/></p><div class="card-meta"><span>{chapter.updated}</span><a href={`${base}investigations/${chapter.slug}/`}><Text k="readChapter"/> →</a></div></article>
