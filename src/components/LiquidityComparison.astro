---
import Text from './Text.astro';
import Option from './Option.astro';
import SourceInfo from './SourceInfo.astro';
import ui from '../data/essay-ui.json';
import evidence from '../data/evidence.json';
const initial=evidence.liquidity.periods[0];
const markets=['A-share','US','HK','JP'];
---
<section class="essay-instrument" data-liquidity-comparison aria-labelledby="essay-liquidity-title"><h3 id="essay-liquidity-title"><Text value={ui.liquidityTitle}/></h3><p><Text value={ui.liquidityIntro}/></p><div class="instrument-controls"><label><Text value={ui.period}/><select data-liquidity="period">{evidence.liquidity.periods.map(p=><option value={p.id}>{p.start} / {p.end}</option>)}</select></label><label><Text value={ui.basis}/><select data-liquidity="basis"><Option value="absolute" text={ui.absolute}/><Option value="relative" text={ui.relative}/></select></label><label><Text value={ui.bucket}/><select data-liquidity="bucket">{evidence.liquidity.buckets.absolute.map((b,i)=><option value={i}>{b}</option>)}</select></label></div><p class="small muted"><Text value={ui.metric}/></p><div class="essay-plot" data-liquidity-chart></div><p class="small muted"><Text value={ui.tableHelp}/></p><div class="table-scroll"><table><thead><tr><th><Text value={ui.market}/></th><th><Text value={ui.metric}/></th><th><Text value={ui.observations}/></th><th><Text value={ui.stocks}/></th></tr></thead><tbody data-liquidity-rows>{markets.map(market=>{const row=initial.absolute.find(r=>r.market===market&&r.bucket===0);return <tr><td><Text k={market}/></td><td>{row?.medianUSD==null?<Text value={ui.missingValue}/>:row.medianUSD.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2})}</td><td>{row?.observations??'—'}</td><td>{row?.stocks??'—'}</td></tr>;})}</tbody></table></div><p class="boundary-note"><Text value={evidence.liquidity.caveat}/></p><p data-liquidity-source></p><SourceInfo ids={[evidence.liquidity.sourceId,evidence.liquidity.relativeSourceId]}/></section>
<script>
import data from '../data/evidence.json';import ui from '../data/essay-ui.json';import {selectLiquidity} from '../lib/research';import {text,local,format} from '../lib/i18n';
const root=document.querySelector<HTMLElement>('[data-liquidity-comparison]')!;
if(root){
const field=(name:string)=>root.querySelector<HTMLSelectElement>(`[data-liquidity="${name}"]`)!;
const render=()=>{const basis=field('basis').value as 'absolute'|'relative';const selected=selectLiquidity(data,{period:field('period').value,basis,bucket:Number(field('bucket').value)});const markets=['A-share','US','HK','JP'];const rows=selected.rows.filter(r=>r.medianUSD!==null);const max=Math.max(1,...rows.map(r=>r.medianUSD!));const ns='http://www.w3.org/2000/svg';const svg=document.createElementNS(ns,'svg');svg.setAttribute('viewBox','0 0 850 270');svg.setAttribute('role','img');svg.setAttribute('aria-label',local(ui.metric));const addText=(s:string,x:number,y:number)=>{const t=document.createElementNS(ns,'text');t.setAttribute('x',String(x));t.setAttribute('y',String(y));t.setAttribute('font-size','13');t.setAttribute('fill','currentColor');t.textContent=s;svg.append(t);};
root.querySelector('[data-liquidity-rows]')!.replaceChildren(...markets.map((market,i)=>{const row=selected.rows.find(r=>r.market===market);const present=selected.period?.markets.includes(market);const value=row?.medianUSD;const y=20+i*60;addText(text(market),8,y+22);if(value!=null){const bar=document.createElementNS(ns,'rect');bar.setAttribute('x','210');bar.setAttribute('y',String(y));bar.setAttribute('width',String(value/max*420));bar.setAttribute('height','28');bar.setAttribute('fill','var(--plot-series)');svg.append(bar);addText('$'+format(value,{notation:'compact',maximumFractionDigits:2}),650,y+22);}else addText(local(present?ui.missingValue:ui.missingMarket),210,y+22);const tr=document.createElement('tr');const cells=[text(market),value==null?local(present?ui.missingValue:ui.missingMarket):'$'+format(value,{maximumFractionDigits:2}),row?format(row.observations):'—',row?format(row.stocks):'—'];cells.forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.append(td);});return tr;}));root.querySelector('[data-liquidity-chart]')!.replaceChildren(svg);const a=document.createElement('a');a.href=(document.body.dataset.base??'')+'methods/#'+selected.sourceId;a.textContent=local(ui.source)+' · '+selected.sourceId;root.querySelector('[data-liquidity-source]')!.replaceChildren(a);};
const buckets=()=>{const value=field('bucket').value;const basis=field('basis').value as 'absolute'|'relative';field('bucket').replaceChildren(...data.liquidity.buckets[basis].map((b,i)=>{const o=document.createElement('option');o.value=String(i);o.textContent=b;return o;}));field('bucket').value=value;};
for(const name of ['period','basis','bucket'])field(name).addEventListener('change',()=>{if(name==='basis')buckets();render();});document.addEventListener('research:locale',render);render();
}
</script>
<style>.essay-instrument{border:1px solid var(--line);padding:1.5rem;margin:2rem 0;background:var(--panel)}.instrument-controls{display:flex;flex-wrap:wrap;gap:1rem;margin:1.5rem 0}.instrument-controls label{display:grid;gap:.5rem;font:14px/1.5 system-ui}.essay-plot{overflow-x:auto;margin:1rem 0}.essay-plot :global(svg){width:100%;min-width:650px;display:block}.essay-instrument table{min-width:650px;width:100%;font-size:13px}.essay-instrument :global(h3){margin-top:0}@media(max-width:600px){.essay-instrument{padding:1rem}.instrument-controls select{max-width:100%}}</style>
