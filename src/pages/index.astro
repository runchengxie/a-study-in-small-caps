---
import HomeResearchChart from '../components/HomeResearchChart.astro';import Site from '../layouts/Site.astro';import Text from '../components/Text.astro';import ChapterCard from '../components/ChapterCard.astro';import research from '../data/research.json';
import '../vendor/enrichr/particle-wave.css';
import ui from '../data/ui.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<Site cover>
<div id="particle-wave-root">
<section class="hero ef-pwave" aria-labelledby="cover-title">
  <canvas id="particle-terrain" class="ef-pwave__c" aria-hidden="true"></canvas>
  <div class="ef-pwave__stage">
    <div class="ef-pwave__sec"><h1 id="cover-title" class="ef-pwave__title"><span class="sr-only"><Text k="brand"/></span><span aria-hidden="true" class="ef-pwave__line ef-pwave__t1"><span class="lang-en">{ui.coverLine1.en}</span><span class="lang-zh" lang="zh-CN">{Array.from(ui.coverLine1.zh).map(character => character === ui.coverSmallGlyph.zh ? <span class="cover-micro">{character}</span> : character)}</span></span><span aria-hidden="true" class="ef-pwave__line ef-pwave__line--accent ef-pwave__t2"><Text k="coverLine2"/></span></h1><p class="ef-pwave__cap"><Text k="coverNote"/></p></div>
    <div class="ef-pwave__sec ef-pwave__sec--next" aria-hidden="true"><p class="ef-pwave__next"><Text k="exploreResearch"/></p></div>
  </div>
  <div class="ef-pwave__hud"><span class="ef-pwave__tl" aria-hidden="true"><Text k="waveDive"/></span><span class="ef-pwave__tr" aria-hidden="true">A · US · HK · JP</span><a class="ef-pwave__bl cover-enter" href="#research"><Text k="enterResearch"/> ↓</a><button id="motion-toggle" hidden class="ef-pwave__br motion-toggle" type="button" aria-pressed="false"><Text k="pauseMotion"/></button><span class="ef-pwave__bar" aria-hidden="true"><i class="ef-pwave__fill"></i></span><span class="ef-pwave__hint" aria-hidden="true">▼ <Text k="waveScroll"/> ▼</span></div>
</section>
</div>
<section id="research" class="section"><div class="section-heading"><span class="eyebrow">01 / <Text k="current"/></span><h2><Text k="current"/></h2></div><div class="claim-grid">{research.claims.slice(0,3).map(claim=><article class="claim-card"><div class="eyebrow"><a href={`${base}history/#${claim.id}`}>{claim.id}</a><span class="status"><Text k={claim.stage}/></span></div><h3><Text value={claim.title}/></h3><p><Text value={claim.statement}/></p></article>)}</div></section>
<section class="section"><div class="section-heading"><span class="eyebrow">02 / <Text k="investigations"/></span><h2><Text k="latest"/></h2></div><div class="chapter-list">{research.investigations.map(chapter=><ChapterCard chapter={chapter} listing/>)}</div></section>
<HomeResearchChart/>
<section class="reading-note"><span class="eyebrow"><Text k="readingRecord"/></span><h2><Text k="crosscheck"/></h2><p><Text k="crosscheckIntro"/></p><a class="text-link" href={`${base}literature/`}><Text k="literature"/> →</a></section></Site>

<script>import {initializeTerrain} from "../lib/terrain.ts";initializeTerrain();</script>
