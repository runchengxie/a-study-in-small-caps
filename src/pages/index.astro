---
import Site from '../layouts/Site.astro';import Text from '../components/Text.astro';import ChapterCard from '../components/ChapterCard.astro';import research from '../data/research.json';
// Static terrain uses the same designed surface as the shader; it is not market data.
const terrain = Array.from({length: 48 * 34}, (_, i) => {
 const x = (i % 48 / 47 - .5) * 30, z = Math.floor(i / 48) / 33 * 27;
 const height = Math.sin(x * .38 + z * .18) * .9 + Math.cos(x * .22 - z * .32) * .65;
 const depth = 4.5 / (z + 6);
 return {x: 720 + x * depth * 144, y: 300 - (-.1 + (height - 1.8) * depth) * 300, r: .55 + depth * 1.8, opacity: .18 + depth * .6};
});
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<Site cover>
<section class="hero" aria-labelledby="cover-title">
  <div class="cover-copy"><div class="eyebrow"><span class="dot"></span><Text k="project"/></div>
  <h1 id="cover-title"><span class="sr-only"><Text k="brand"/></span><span aria-hidden="true" class="cover-title-line"><Text k="coverLine1"/></span><span aria-hidden="true" class="cover-title-line"><Text k="coverLine2"/></span></h1>
  <p class="cover-note"><Text k="coverNote"/></p></div>
  <div class="terrain" aria-hidden="true"><svg class="terrain-fallback" viewBox="0 0 1440 600" preserveAspectRatio="none">{terrain.map(point=><circle cx={point.x} cy={point.y} r={point.r} opacity={point.opacity}/>)}</svg><canvas id="particle-terrain"></canvas></div>
  <div class="cover-bottom"><a class="cover-enter" href="#research"><span class="scroll-arrow" aria-hidden="true">↓</span><Text k="enterResearch"/></a><span class="cover-markets">A · US · HK · JP</span><button id="motion-toggle" hidden class="motion-toggle" type="button" aria-pressed="false"><span class="motion-pause"><Text k="pauseMotion"/></span><span class="motion-resume"><Text k="resumeMotion"/></span></button></div>
</section>
<section id="research" class="section"><div class="section-heading"><span class="eyebrow">01 / <Text k="current"/></span><h2><Text k="current"/></h2></div><div class="claim-grid">{research.claims.slice(0,3).map(claim=><article class="claim-card"><div class="eyebrow"><a href={`${base}history/#${claim.id}`}>{claim.id}</a><span class="status"><Text k={claim.stage}/></span></div><h3><Text value={claim.title}/></h3><p><Text value={claim.statement}/></p></article>)}</div></section>
<section class="section"><div class="section-heading"><span class="eyebrow">02 / <Text k="investigations"/></span><h2><Text k="latest"/></h2></div><div class="chapter-grid">{research.investigations.map(chapter=><ChapterCard chapter={chapter}/>)}</div></section>
<section class="reading-note"><span class="eyebrow"><Text k="readingRecord"/></span><h2><Text k="crosscheck"/></h2><p><Text k="crosscheckIntro"/></p><a class="text-link" href={`${base}literature/`}><Text k="literature"/> →</a></section></Site>

<script>import {initializeTerrain} from "../lib/terrain.ts";initializeTerrain();</script>
