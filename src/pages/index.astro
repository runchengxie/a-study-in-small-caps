---
import Site from '../layouts/Site.astro';import Text from '../components/Text.astro';import ChapterCard from '../components/ChapterCard.astro';import research from '../data/research.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<Site><section class="hero"><div class="eyebrow"><span class="dot"></span><Text k="project"/></div><h1><Text k="hero"/></h1><p class="hero-intro"><Text k="intro"/></p><div class="hero-actions"><a class="button" href={`${base}investigations/`}><Text k="begin"/> →</a><a class="text-link" href={`${base}evidence/`}><Text k="browseEvidence"/> ↗</a></div><div class="hero-index"><span>01—03 <Text k="investigations"/></span><span>05 <Text k="literature"/></span><span>A · US · HK · JP</span></div></section>
<section class="section"><div class="section-heading"><span class="eyebrow">01 / <Text k="current"/></span><h2><Text k="current"/></h2></div><div class="claim-grid">{research.claims.slice(0,3).map(claim=><article class="claim-card"><div class="eyebrow"><a href={`${base}history/#${claim.id}`}>{claim.id}</a><span class="status"><Text k={claim.stage}/></span></div><h3><Text value={claim.title}/></h3><p><Text value={claim.statement}/></p></article>)}</div></section>
<section class="section"><div class="section-heading"><span class="eyebrow">02 / <Text k="investigations"/></span><h2><Text k="latest"/></h2></div><div class="chapter-grid">{research.investigations.map(chapter=><ChapterCard chapter={chapter}/>)}</div></section>
<section class="reading-note"><span class="eyebrow"><Text k="readingRecord"/></span><h2><Text k="crosscheck"/></h2><p><Text k="crosscheckIntro"/></p><a class="text-link" href={`${base}literature/`}><Text k="literature"/> →</a></section></Site>
