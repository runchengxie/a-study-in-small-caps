---
import Site from '../layouts/Site.astro';
import {validateRoadmap} from '../lib/roadmap';
import Text from '../components/Text.astro';
import Option from '../components/Option.astro';
import SourceInfo from '../components/SourceInfo.astro';
import agenda from '../../public/evidence/research-roadmap.json';
import progress from '../../public/evidence/target-support-roadmap.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
validateRoadmap(agenda);
const statuses:Record<string,string>={done:'roadmapDone',partial:'roadmapPartial',ready:'roadmapReady',waiting:'roadmapWaiting'};
const streams:Record<string,string>={data:'roadmapData',account:'roadmapAccount',factors:'roadmapFactors',portfolio:'roadmapPortfolio',execution:'roadmapExecution',validation:'roadmapValidation',publication:'roadmapPublication'};
const arms:Record<string,string>={benchmark:'roadmapBenchmark',exclude_high_turnover:'roadmapExclude',low_turnover:'roadmapLowturn'};
const nextTasks=agenda.tasks.filter(t=>['ready','partial'].includes(t.status)&&t.dependsOn.every(id=>agenda.tasks.find(p=>p.id===id)?.status==='done'));
const report='https://github.com/runchengxie/quant-market-research/blob/8700d713df32f249f7f9624d50ae5687af642c98/docs/research/experiments/smallcap-target-support-20261128.md';
---
<Site title="Research checklist & evidence map" active="roadmap">
<header class="page-intro"><p class="eyebrow"><Text k="roadmapUpdated"/> · {agenda.reviewedOn}</p><h1><Text k="roadmapTitle"/></h1><p class="lead"><Text k="roadmapIntro"/></p><p class="boundary-note"><Text k="roadmapStatusNote"/></p><p><a href={`${base}evidence/research-roadmap.json`} download><Text k="roadmapDownload"/></a></p></header>
<div class="roadmap-counts">{Object.entries(statuses).map(([status,key])=><div><strong>{agenda.tasks.filter(t=>t.status===status).length}</strong><Text k={key}/></div>)}</div>
<section class="section" id="ready"><h2><Text k="roadmapNext"/></h2><p><Text k="roadmapNextNote"/></p><ul>{nextTasks.map(t=><li><a href={`#${t.id}`}>{t.id} · <Text value={t.title}/></a></li>)}</ul></section>
<section class="section" id="target-support"><h2><Text k="roadmapProgress"/></h2><p><Text k="roadmapProgressIntro"/></p><div class="roadmap-table"><table><thead><tr><th><Text k="roadmapArm"/></th><th><Text k="roadmapNames"/></th><th><Text k="roadmapLowvol"/></th><th><Text k="roadmapChange"/></th></tr></thead><tbody>{progress.rows.filter(r=>r.scope==='smallest_20pct').map(r=><tr><th><Text k={arms[r.arm]}/></th><td>{r.selected_count.toFixed(1)}</td><td>{r.lowvol_score_vs_benchmark.toFixed(3)}</td><td>{(r.target_change_half_l1*100).toFixed(2)}%</td></tr>)}</tbody></table></div><p class="small muted"><Text k="roadmapExposureUnit"/></p><p><Text k="roadmapProgressNote"/></p><p><Text k="roadmapProgressFinding"/></p><a class="text-link" href={report}><Text k="roadmapReport"/> ↗</a><SourceInfo ids={['SRC-TARGET-SUPPORT-ROADMAP']}/></section>
<section class="section" id="checklist"><h2><Text k="roadmapTasks"/></h2>
<form id="roadmap-filters" hidden onsubmit="return false"><label><Text k="roadmapSearch"/><input id="task-search" type="search"/></label><label><Text k="roadmapPriority"/><select id="task-priority"><Option value="all" k="all"/>{['P0','P1','P2','P3'].map(p=><option value={p}>{p}</option>)}</select></label><label><Text k="roadmapStatus"/><select id="task-status"><Option value="all" k="all"/>{Object.entries(statuses).map(([status,key])=><Option value={status} k={key}/>)}</select></label><button id="task-reset" type="button"><Text k="roadmapReset"/></button></form>
<p id="task-count" aria-live="polite">30 / 30</p><p id="task-empty" hidden><Text k="roadmapEmpty"/></p>
<div class="roadmap-tasks">{agenda.tasks.map(task=><details id={task.id} data-task data-priority={task.priority} data-status={task.status} data-search={JSON.stringify(task).toLowerCase()}><summary><span class="eyebrow">{task.id} · {task.priority}</span><span><Text value={task.title}/></span><span class="status"><Text k={statuses[task.status]}/></span></summary><p class="small muted"><Text k={streams[task.workstream]}/> · <Text k="roadmapOwner"/>: {task.owner}</p><h3><Text k="roadmapAcceptance"/></h3><p><Text value={task.acceptance}/></p><h3><Text k="roadmapNextAction"/></h3><p><Text value={task.nextAction}/></p><h3><Text k="roadmapDependency"/></h3>{task.dependsOn.length?<p class="task-dependencies">{task.dependsOn.map(id=><a href={`#${id}`}>{id} · <Text value={agenda.tasks.find(t=>t.id===id)!.title}/></a>)}</p>:<p><Text k="roadmapNoDeps"/></p>}{task.gap&&<><h3><Text k="roadmapGap"/></h3><p class="boundary-note"><Text value={task.gap}/></p></>}{task.evidence.length>0&&<><h3><Text k="roadmapEvidence"/></h3><p class="task-dependencies">{task.evidence.map((url,i)=><a href={url}><Text k="openSource"/> {i+1} ↗</a>)}</p></>}</details>)}</div>
<SourceInfo ids={['SRC-SMALLCAP-ROADMAP']}/></section>
</Site>
<style>
.roadmap-counts{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;border-block:1px solid var(--line);padding:1.5rem 0}.roadmap-counts>div{display:grid;gap:.5rem}.roadmap-counts strong{font:2.5rem var(--serif)}
#roadmap-filters{display:flex;gap:1rem;flex-wrap:wrap;align-items:end}#roadmap-filters[hidden]{display:none}#roadmap-filters label{display:grid;gap:.5rem}#roadmap-filters input,#roadmap-filters select,#roadmap-filters button{font:inherit;color:var(--ink);background:var(--panel);padding:.7rem;border:1px solid var(--line);max-width:100%}
.roadmap-tasks details{border-top:1px solid var(--line);padding:1.3rem 0;scroll-margin-top:2rem;overflow-wrap:anywhere}.roadmap-tasks summary{cursor:pointer;display:grid;grid-template-columns:8rem minmax(0,1fr) auto;gap:1rem;align-items:baseline;font-size:1.1rem}.roadmap-tasks h3{font-size:.9rem;margin:1.5rem 0 .4rem}.roadmap-tasks p{max-width:80ch;line-height:1.8}.task-dependencies{display:flex;gap:1rem;flex-wrap:wrap}.roadmap-table{overflow:auto;max-width:100%}.roadmap-table table{width:100%;border-collapse:collapse}.roadmap-table th,.roadmap-table td{padding:1rem;text-align:left;border-bottom:1px solid var(--line)}
@media(max-width:700px){.roadmap-counts{grid-template-columns:repeat(2,1fr)}.roadmap-tasks summary{grid-template-columns:1fr;font-size:1rem;gap:.5rem}#roadmap-filters label{width:100%}#roadmap-filters input{width:100%}}
</style>
<script>
import {format} from '../lib/i18n';
const tasks=[...document.querySelectorAll<HTMLDetailsElement>('[data-task]')];
const search=document.querySelector<HTMLInputElement>('#task-search')!;
const priority=document.querySelector<HTMLSelectElement>('#task-priority')!;
const status=document.querySelector<HTMLSelectElement>('#task-status')!;
const render=()=>{const terms=search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);let count=0;for(const task of tasks){task.hidden=!(priority.value==='all'||task.dataset.priority===priority.value)||!(status.value==='all'||task.dataset.status===status.value)||!terms.every(t=>task.dataset.search!.includes(t));if(!task.hidden)count++;}document.querySelector('#task-count')!.textContent=`${format(count)} / ${format(tasks.length)}`;document.querySelector<HTMLElement>('#task-empty')!.hidden=count!==0;};
const reset=()=>{search.value='';priority.value='all';status.value='all';render();};
const followHash=()=>{const id=location.hash.slice(1);if(!/^SC-\d{3}$/.test(id))return;const task=tasks.find(t=>t.id===id);if(task){reset();task.open=true;requestAnimationFrame(()=>task.scrollIntoView());}};
search.addEventListener('input',render);priority.addEventListener('change',render);status.addEventListener('change',render);document.querySelector('#task-reset')!.addEventListener('click',reset);document.addEventListener('research:locale',render);window.addEventListener('hashchange',followHash);document.querySelector<HTMLElement>('#roadmap-filters')!.hidden=false;render();followHash();
</script>
