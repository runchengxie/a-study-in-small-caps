---
import focusUI from '../../data/research-focus-ui.json';
import Site from '../../layouts/Site.astro';import Text from '../../components/Text.astro';import ChapterCard from '../../components/ChapterCard.astro';import SearchPanel from '../../components/SearchPanel.astro';import research from '../../data/research.json';
---
<Site title="Investigations" active="investigations"><header class="page-intro"><p class="eyebrow"><Text k="investigationEyebrow"/></p><h1><Text k="investigations"/></h1><p><Text k="chaptersIntro"/></p><p><a class="text-link" href={`${import.meta.env.BASE_URL.replace(/\/$/,'')}/reading-guide/`}><Text value={focusUI.readingGuide}/> →</a></p><p><a class="text-link" href={`${import.meta.env.BASE_URL.replace(/\/$/,'')}/roadmap/`}><Text k="roadmapTitle"/> →</a></p></header><div class="chapter-list">{research.investigations.map(chapter=><ChapterCard chapter={chapter} listing/>)}</div><SearchPanel initialType="investigation"/></Site>
