---
import Site from '../../layouts/Site.astro';import Text from '../../components/Text.astro';import SourceInfo from '../../components/SourceInfo.astro';import research from '../../data/research.json';
export function getStaticPaths(){return research.investigations.map(chapter=>({params:{slug:chapter.slug},props:{chapter}}));}
const {chapter}=Astro.props;const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';const papers=research.literature.filter(p=>chapter.literatureIds.includes(p.id));
---
<Site title={chapter.title.en} active="investigations" description={chapter.summary.en}><header class="chapter-intro"><p class="eyebrow">{chapter.id} · {chapter.updated} · <Text k={chapter.stage==='methods'?'methodsStage':chapter.stage}/></p><h1><Text value={chapter.title}/></h1><p class="lead"><Text value={chapter.question}/></p><div class="finding"><span class="eyebrow"><Text k="current"/></span><p><Text value={chapter.conclusion}/></p></div></header>
<div class="article-layout"><aside class="article-nav" aria-label="Chapter sections" data-aria="chapterSections">{chapter.sections.map(section=><a href={`#${section.id}`}><Text value={section.title}/></a>)}<a href="#limitations"><Text k="sample"/></a><a href="#next"><Text k="nextQuestion"/></a></aside><article class="prose">{chapter.sections.map(section=><section id={section.id}><h2><Text value={section.title}/></h2>{section.paragraphs.map(paragraph=><p><Text value={paragraph}/></p>)}{section.figure&&<a class="evidence-link" href={`${base}evidence/#${section.figure}`}><Text k="browseEvidence"/> →</a>}</section>)}<section id="limitations"><h2><Text k="sample"/></h2><ul>{chapter.limitations.map(item=><li><Text value={item}/></li>)}</ul></section><section id="next"><h2><Text k="nextQuestion"/></h2><ul>{chapter.nextSteps.map(item=><li><Text value={item}/></li>)}</ul></section><section><h2><Text k="papers"/></h2>{papers.map(paper=><p><a href={`${base}literature/#${paper.id}`}>{paper.title}</a> · {paper.year} · <Text k={paper.stage}/></p>)}</section><SourceInfo ids={chapter.sourceIds}/></article></div></Site>
