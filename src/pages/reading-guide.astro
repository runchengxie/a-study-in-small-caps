---
import Site from '../layouts/Site.astro';
import Text from '../components/Text.astro';
import SourceInfo from '../components/SourceInfo.astro';
import guide from '../data/reading-guide.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<Site title={guide.title.en} active="investigations"><header class="page-intro"><p class="eyebrow">v1.0.10 → <Text k="investigations"/></p><h1><Text value={guide.title}/></h1><p class="lead"><Text value={guide.intro}/></p></header>
<section class="section"><h2><Text value={guide.topicsTitle}/></h2><div class="guide-topics">{guide.chapters.map(c=><article><h3><a href={`${base}${c.href}`}><Text value={c.title}/></a></h3><p><Text value={c.summary}/></p></article>)}</div></section>
<section class="section"><h2><Text value={guide.download}/></h2><p class="boundary-note"><Text value={guide.archiveNote}/></p><div class="download-links"><a href={`${base}${guide.archives.en.path}`} download>English · Markdown</a><a href={`${base}${guide.archives.zh.path}`} download>简体中文 · Markdown</a></div><SourceInfo ids={['SRC-ARCHIVE','SRC-ARCHIVE-EN']}/></section>
<section class="section" id="research-history"><h2><Text value={guide.historyTitle}/></h2><p><Text value={guide.historyIntro}/></p><label class="guide-search"><Text value={guide.search}/><input id="guide-search" type="search"/></label><p id="guide-count" aria-live="polite">42 / 42</p><p id="guide-empty" hidden><Text value={guide.empty}/></p><div class="history-records">{guide.records.map(record=><details id={record.id} data-guide-record data-search={JSON.stringify(record).toLowerCase()}><summary><span class="eyebrow">{record.id}</span><Text value={record.title}/></summary><p class="small muted"><Text value={record.scope}/></p><h4><Text value={guide.finding}/></h4><p><Text value={record.finding}/></p>{record.open.en&&<><h4><Text value={guide.open}/></h4><p><Text value={record.open}/></p></>}<a class="lang-en text-link" href={`${guide.archives.en.sourceUrl}#L${record.sourceLine.en}`}>{guide.openSource.en} ↗</a><a class="lang-zh text-link" href={`${guide.archives.zh.sourceUrl}#L${record.sourceLine.zh}`}>{guide.openSource.zh} ↗</a></details>)}</div></section></Site>
<style>.guide-topics{display:grid;grid-template-columns:1fr 1fr;gap:1rem 3rem}.guide-topics article{border-top:1px solid var(--line);padding:1rem 0}.guide-topics h3{margin:.5rem 0}.guide-topics p{line-height:1.8;max-width:50ch}.download-links{display:flex;gap:2rem;flex-wrap:wrap;margin:1.5rem 0}.guide-search{display:grid;gap:.7rem;max-width:30rem}.guide-search input{font:inherit;padding:.7rem;background:var(--panel);color:var(--ink);border:1px solid var(--line)}.history-records details{border-top:1px solid var(--line);padding:1.25rem 0}.history-records summary{cursor:pointer;display:flex;gap:1.5rem;align-items:baseline;font-size:1.15rem}.history-records p{max-width:80ch;line-height:1.85}.history-records h4{font-size:14px;margin:1.5rem 0 .5rem}@media(max-width:700px){.guide-topics{grid-template-columns:1fr}.history-records summary{gap:1rem;font-size:1rem}}</style>
<script>
import {format} from '../lib/i18n';
const field=document.querySelector<HTMLInputElement>('#guide-search')!;
const search=()=>{const terms=field.value.trim().toLowerCase().split(/\s+/).filter(Boolean);let count=0;const records=[...document.querySelectorAll<HTMLElement>('[data-guide-record]')];for(const record of records){record.hidden=!terms.every(t=>record.dataset.search!.includes(t));if(!record.hidden)count++;}document.querySelector('#guide-count')!.textContent=`${format(count)} / ${format(records.length)}`;(document.querySelector('#guide-empty') as HTMLElement).hidden=count!==0;};
field.addEventListener('input',search);document.addEventListener('research:locale',search);search();
</script>
